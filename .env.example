# API del BCRA es pública, no requiere key. Se deja la base URL por si cambia.
BCRA_API_BASE_URL=https://api.bcra.gob.ar

# Base de datos
DATABASE_URL=

# API de Claude (Anthropic) para el motor de análisis de ofertas
ANTHROPIC_API_KEY=

# Proveedor de verificación de identidad (definir cuál se usa)
IDENTITY_VERIFICATION_API_KEY=

# Pasarela de pago (Mercado Pago Checkout Pro)
PAYMENTS_API_KEY=
# URLs a las que Mercado Pago redirige al usuario después del pago
PAYMENTS_SUCCESS_URL=http://localhost:3000/pago/exito
PAYMENTS_FAILURE_URL=http://localhost:3000/pago/error
PAYMENTS_PENDING_URL=http://localhost:3000/pago/pendiente

# Feature flag del módulo de gestoría activa (15%) — desactivado hasta
# validación legal, ver docs/LEGAL-NOTES.md
ENABLE_NEGOTIATION=false
